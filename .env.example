# ============================================
# AYUSH-Care Environment Configuration
# ============================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# --- Supabase ---
# URL of your Supabase project (find this in project settings)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public anon key for frontend Supabase interactions
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Secret service role key for backend-only admin access
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Postgres connection string for direct DB access
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- LLM APIs ---
# Primary LLM provider (Google Gemini)
GEMINI_API_KEY=your-gemini-api-key
# Fallback LLM provider (Groq - fast inference)
GROQ_API_KEY=your-groq-api-key
# Secondary fallback LLM provider
OPENROUTER_API_KEY=your-openrouter-api-key

# --- LLM Configuration ---
# Active provider: gemini | groq | openrouter
LLM_PROVIDER=gemini
# Model identifier (e.g. gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash
# Maximum number of tokens for output generation
LLM_MAX_TOKENS=1024
# Low temperature ensures clinical consistency and deterministic outputs
LLM_TEMPERATURE=0.3

# --- Server ---
# Port for FastAPI backend
BACKEND_PORT=8000
# Port for Vite React frontend
FRONTEND_PORT=5173
# Allowed CORS origins for backend (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Feature Flags ---
# Enable browser Web Speech API for voice input
ENABLE_VOICE_INPUT=true
# Enable Tesseract.js OCR for printed document scanning
ENABLE_OCR=true
# Enable real-time background red-flag detection
ENABLE_RED_FLAGS=true
# Enable mock ABDM UI (ABHA linking and HIS push)
ENABLE_MOCK_ABDM=true

# --- Session ---
# Number of minutes before an idle session times out
SESSION_TIMEOUT_MINUTES=30
# Automatically clear session data upon completion/timeout
SESSION_AUTO_CLEAR=true
