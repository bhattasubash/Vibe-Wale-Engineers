# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Wispr Flow Voice Interface API Configuration
WISPRFLOW_API_KEY=your_wisprflow_api_key_here

# Tesseract OCR Verification Configuration
TESSERACT_CONFIDENCE_THRESHOLD=80
# If tesseract is not in your system PATH, specify its absolute path here:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# rapidfuzz label matching similarity threshold (0-100)
RAPIDFUZZ_SIMILARITY_THRESHOLD=80

# Upload limits (in bytes, default 15MB)
MAX_UPLOAD_SIZE=15728640

# Storage base directory
STORAGE_DIR=storage
