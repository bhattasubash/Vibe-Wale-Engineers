        <mxCell id="e_inp" value="1. PATIENT INTAKE STREAM&#xa;Chief Complaint Categorization Input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#0D6E6E;strokeWidth=2;fontStyle=1;fontSize=13;" vertex="1" parent="1">
