        <mxCell id="q_a" value="Associated Symptoms&#xa;Secondary autonomic signs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="e_soc">
