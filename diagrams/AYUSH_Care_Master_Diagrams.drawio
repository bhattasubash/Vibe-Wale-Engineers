        <!-- SOCRATES QUESTIONS -->
        <mxCell id="e_soc" value="3. SOCRATES QUESTION ONTOLOGY (questions.json)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="1440" height="120" as="geometry"/>
