        <mxCell id="q_c" value="Character Analysis&#xa;Pain/Discomfort sensation type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="e_soc">
          <mxGeometry x="510" y="45" width="200" height="55" as="geometry"/>
