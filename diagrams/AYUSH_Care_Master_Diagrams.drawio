        <mxCell id="b5" value="Branch E: Twak &amp; Dermatological" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontStyle=1;" vertex="1" parent="e_cat">
          <mxGeometry x="990" y="40" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b6" value="Branch F: General Constitutional" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontStyle=1;" vertex="1" parent="e_cat">
          <mxGeometry x="1230" y="40" width="180" height="50" as="geometry"/>
