        <mxCell id="q_s" value="Site Analysis&#xa;Anatomical symptom locus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="e_soc">
          <mxGeometry x="30" y="45" width="200" height="55" as="geometry"/>
