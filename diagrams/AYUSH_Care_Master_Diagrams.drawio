  <!-- ========================================== -->
  <!-- PAGE 4: PRAKRITI SCORING ALGORITHM        -->
  <!-- ========================================== -->
  <diagram id="diag_prakriti" name="4. Prakriti Scoring Algorithm">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" background="#FAFBFC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p_box" value="CHARAKA SAMHITA PRAKRITI SCORING ALGORITHM (Vimana Sthana Chapter 8)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#0D6E6E;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#0D6E6E;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="1480" height="980" as="geometry"/>
        </mxCell>

        <!-- INPUTS -->
        <mxCell id="p_in1" value="PK-01 Body Build&#xa;PK-02 Weight Tendency&#xa;PK-03 Skin Texture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D6E6E;fontStyle=1;" vertex="1" parent="p_box">
          <mxGeometry x="40" y="50" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p_in2" value="PK-04 Hair Quality&#xa;PK-05 Facial Structure&#xa;PK-06 Eye Features" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D6E6E;fontStyle=1;" vertex="1" parent="p_box">
          <mxGeometry x="340" y="50" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p_in3" value="PK-07 Appetite Pattern&#xa;PK-08 Bowel Habit&#xa;PK-09 Thirst Pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D6E6E;fontStyle=1;" vertex="1" parent="p_box">
          <mxGeometry x="640" y="50" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p_in4" value="PK-10 Sleep Quality&#xa;PK-11 Weather Preference&#xa;PK-12 Memory Recall" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D6E6E;fontStyle=1;" vertex="1" parent="p_box">
          <mxGeometry x="940" y="50" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p_in5" value="PK-13 Temperament&#xa;PK-14 Speech Pattern&#xa;PK-15 Physical Movement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D6E6E;fontStyle=1;" vertex="1" parent="p_box">
          <mxGeometry x="1220" y="50" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- ACCUMULATOR -->
        <mxCell id="acc_box" value="ARITHMETIC ACCUMULATOR&#xa;Vata_Score = Count(Option A)&#xa;Pitta_Score = Count(Option B)&#xa;Kapha_Score = Count(Option C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#B45309;" vertex="1" parent="p_box">
          <mxGeometry x="490" y="170" width="500" height="90" as="geometry"/>
        </mxCell>

        <!-- NORMALIZER -->
        <mxCell id="norm_box" value="PERCENTAGE NORMALIZATION&#xa;Total = Vata_Score + Pitta_Score + Kapha_Score (Total = 15)&#xa;Vata_Percentage = (Vata_Score / 15) * 100&#xa;Pitta_Percentage = (Pitta_Score / 15) * 100&#xa;Kapha_Percentage = (Kapha_Score / 15) * 100" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#B45309;" vertex="1" parent="p_box">
          <mxGeometry x="490" y="300" width="500" height="110" as="geometry"/>
        </mxCell>

        <!-- GAP LOGIC -->
        <mxCell id="gap_box" value="DOMINANCE &amp; CONFIDENCE BAND EVALUATION&#xa;Sort Descending: [D1_Score &gt;= D2_Score &gt;= D3_Score]&#xa;Confidence_Gap = D1_Score - D2_Score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#1D4ED8;" vertex="1" parent="p_box">
          <mxGeometry x="490" y="450" width="500" height="90" as="geometry"/>
        </mxCell>

        <!-- BRANCHES -->
        <mxCell id="band_high" value="Confidence_Gap &gt;= 5&#xa;HIGH CONFIDENCE&#xa;Single Dosha Dominance&#xa;(e.g., Predominantly Vata)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontColor=#047857;" vertex="1" parent="p_box">
          <mxGeometry x="150" y="590" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="band_med" value="Confidence_Gap &gt;= 3 and &lt; 5&#xa;MEDIUM CONFIDENCE&#xa;Dual Dosha Dominance&#xa;(e.g., Vata-Kapha)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontStyle=1;fontColor=#B45309;" vertex="1" parent="p_box">
          <mxGeometry x="600" y="590" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="band_low" value="Confidence_Gap &lt; 3&#xa;LOW CONFIDENCE (Sama Prakriti)&#xa;Balanced Constitutional State&#xa;Flagged for Physical Examination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontColor=#DC2626;" vertex="1" parent="p_box">
          <mxGeometry x="1050" y="590" width="280" height="90" as="geometry"/>
        </mxCell>

        <!-- OUTPUT -->
        <mxCell id="p_out" value="OUTPUT CLINICAL DATA CONTRACT&#xa;• prakriti_results Database Insertion&#xa;• Real-Time Interactive Radar Chart Generation&#xa;• Plain-Language Patient Constitution Summary&#xa;• Physician Dashavidha Pariksha Matrix Export" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D6E6E;strokeWidth=2;fontStyle=1;fontSize=13;" vertex="1" parent="p_box">
          <mxGeometry x="440" y="730" width="600" height="110" as="geometry"/>
        </mxCell>

        <!-- CONNECTORS -->
        <mxCell id="pc1" edge="1" parent="p_box" source="p_in3" target="acc_box" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#0D6E6E;" />
        <mxCell id="pc2" edge="1" parent="p_box" source="acc_box" target="norm_box" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#F59E0B;" />
        <mxCell id="pc3" edge="1" parent="p_box" source="norm_box" target="gap_box" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#D97706;" />
        <mxCell id="pc4" edge="1" parent="p_box" source="gap_box" target="band_high" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#059669;" />
        <mxCell id="pc5" edge="1" parent="p_box" source="gap_box" target="band_med" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#F59E0B;" />
        <mxCell id="pc6" edge="1" parent="p_box" source="gap_box" target="band_low" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#DC2626;" />
        <mxCell id="pc7" edge="1" parent="p_box" source="band_high" target="p_out" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#0D6E6E;" />
        <mxCell id="pc8" edge="1" parent="p_box" source="band_med" target="p_out" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#0D6E6E;" />
        <mxCell id="pc9" edge="1" parent="p_box" source="band_low" target="p_out" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#0D6E6E;" />

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ========================================== -->
  <!-- PAGE 5: RED-FLAG EMERGENCY TRIAGE PIPELINE-->
  <!-- ========================================== -->
  <diagram id="diag_redflag" name="5. Red-Flag Emergency Triage">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1100" background="#FAFBFC">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="rf_stream" value="1. REAL-TIME INPUT INGESTION&#xa;Spoken Audio Transcription (Hindi/English)&#xa;Touch Category &amp; Symptom Selections&#xa;Chief Complaint Narrative Stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2F1;strokeColor=#0D6E6E;strokeWidth=2;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="340" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="rf_engine" value="2. IN-MEMORY REGEX SCANNER (&lt;10ms Evaluation)&#xa;Low-Latency String &amp; Keyword Matcher&#xa;Evaluates OR Combinations per Symptom Group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontStyle=1;fontSize=13;fontColor=#B45309;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="380" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="rf_rules" value="3. PRE-CONFIGURED EMERGENCY RULE DEFINITIONS (red-flags.json)&#xa;• RF-01: Acute Chest Pain, Angina, Dyspnea (Cardiac / Respiratory)&#xa;• RF-02: Slurred Speech, Facial Drooping, Paralysis (Stroke / Neuro)&#xa;• RF-03: Stiff Neck, High Pyrexia with Delirium, Fits (Meningitis / Sepsis)&#xa;• RF-04: Hematemesis, Melena, Active Internal Bleeding (GI Emergency)&#xa;• RF-05: Expressed Suicidal Ideation or Self-Harm Intent (Psych Emergency)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontStyle=1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="500" y="270" width="480" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="rf_fork" value="MATCH DETECTED?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontColor=#DC2626;" vertex="1" parent="1">
          <mxGeometry x="960" y="110" width="180" height="100" as="geometry"/>
        </mxCell>

        <!-- DISPATCH ACTIONS -->
        <mxCell id="rf_act1" value="KIOSK SAFETY PROTOCOL (S-08)&#xa;• Non-Blocking Urgent Warning Banner&#xa;• Loud Acoustic TTS Safety Announcement&#xa;• Auto-Resumes Kiosk Flow in 6 Seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontStyle=1;fontColor=#DC2626;" vertex="1" parent="1">
          <mxGeometry x="1220" y="40" width="350" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rf_act2" value="DATABASE PERSISTENCE ACTION&#xa;• Row Insert in red_flags Table&#xa;• Update sessions.red_flag_triggered = true&#xa;• Consent &amp; Audit Trail Logged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="150" width="350" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rf_act3" value="PHYSICIAN QUEUE TRIAGE OVERRIDE&#xa;• Session Raised to Priority #1 Immediately&#xa;• Flashing Red Visual Indicator on Doctor UI&#xa;• Real-Time Queue Re-Sorting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=2;fontStyle=1;fontColor=#047857;" vertex="1" parent="1">
          <mxGeometry x="1220" y="260" width="350" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="rf_normal" value="NORMAL CLINICAL ROUTE&#xa;Proceed without triage interruption" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#059669;strokeWidth=1.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="290" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- CONNECTORS -->
        <mxCell id="rfc1" edge="1" parent="1" source="rf_stream" target="rf_engine" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#0D6E6E;" />
        <mxCell id="rfc2" edge="1" parent="1" source="rf_rules" target="rf_engine" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#D97706;dashed=1;" />
        <mxCell id="rfc3" edge="1" parent="1" source="rf_engine" target="rf_fork" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#D97706;" />
        <mxCell id="rfc4" edge="1" parent="1" source="rf_fork" target="rf_act1" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#DC2626;">
          <mxGeometry relative="1" as="geometry">
            <Array points="1050 80"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="rfc5" edge="1" parent="1" source="rf_fork" target="rf_act2" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#DC2626;" />
        <mxCell id="rfc6" edge="1" parent="1" source="rf_fork" target="rf_act3" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=2;strokeColor=#DC2626;">
          <mxGeometry relative="1" as="geometry">
            <Array points="1050 300"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="rfc7" edge="1" parent="1" source="rf_fork" target="rf_normal" style="edgeStyle=orthogonalEdgeStyle;strokeWidth=1.5;strokeColor=#059669;" />

      </root>
    </mxGraphModel>
  </diagram>

