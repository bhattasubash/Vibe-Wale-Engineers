        <mxCell id="q_t" value="Timing Analysis&#xa;Diurnal cycle &amp; persistence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="e_soc">
          <mxGeometry x="750" y="45" width="200" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="q_e" value="Exacerbating / Relieving&#xa;Aggravating factors &amp; rest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="e_soc">
          <mxGeometry x="990" y="45" width="200" height="55" as="geometry"/>
