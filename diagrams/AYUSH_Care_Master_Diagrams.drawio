        <mxCell id="q_o" value="Onset Analysis&#xa;Duration &amp; temporal pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontStyle=1;" vertex="1" parent="e_soc">
          <mxGeometry x="270" y="45" width="200" height="55" as="geometry"/>
