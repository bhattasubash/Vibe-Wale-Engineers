        <mxCell id="c9" edge="1" parent="1" source="z3_fastapi" target="z4_kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c10" edge="1" parent="1" source="z4_kafka" target="z4_workers">
